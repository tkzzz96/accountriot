# ============================================================
# Prospex — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── Required ─────────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL="postgresql://prospex:yourpassword@localhost:5432/prospex"

# JWT signing secret — min 16 chars, use: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# AES-256-GCM key used to encrypt integration secrets (e.g. OpenAI keys) at rest — 32 random bytes, base64, use: openssl rand -base64 32
ENCRYPTION_KEY=change-me-to-a-base64-encoded-32-byte-key

# ── Database container (used by docker-compose) ───────────────
POSTGRES_USER=prospex
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=prospex

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# For production (set in docker-compose.prod.yml):
# REDIS_PASSWORD=changeme
# REDIS_URL="redis://:changeme@localhost:6379"

# ── AI Provider ───────────────────────────────────────────────
# OpenAI, OpenRouter, Ollama, or any OpenAI-compatible provider
# Leave empty to use built-in mock content (no API cost)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Uncomment to use alternative providers:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://localhost:11434/v1

# ── App URLs ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── Sessions ──────────────────────────────────────────────────
# Browser session lifetime (httpOnly cookie, sliding renewal). Formats: 30m, 12h, 7d.
JWT_EXPIRES_IN=7d
# Force/disable the Secure flag on cookies (default: on when NODE_ENV=production).
# COOKIE_SECURE=false

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Production only ───────────────────────────────────────────
# APP_URL=https://yourdomain.com
# API_URL=https://yourdomain.com
# HTTP_PORT=80
# HTTPS_PORT=443

# ── Prospector ────────────────────────────────────────────────
# Discovery driver: gosom (default) | places | playwright | mock
DISCOVERY_DRIVER=gosom
# In docker-compose the api uses http://gosom:8080
GOSOM_URL=http://localhost:8080
# Official Google Places API (New) — required only when DISCOVERY_DRIVER=places
PLACES_API_KEY=
# SMTP RCPT verification of e-mails (needs outbound port 25). Off by default.
EMAIL_SMTP_VERIFY=false
# Optional: enable curated+Behance/Dribbble reference search
REFERENCE_TTL_DAYS=30
# Reference thumbnails are hotlinked by URL (never stored). {url} is URL-encoded.
# REFERENCE_THUMB_TEMPLATE=https://s0.wp.com/mshots/v1/{url}?w=640&h=400
# Optional (official API only; see apps/api/src/references/README.md)
# PINTEREST_ACCESS_TOKEN=

# Expose Swagger at /api/docs in production (always on in development)
# ENABLE_API_DOCS=false
# Remove shared reference rows that were deleted from the code seed (off by default: rolling deploys / manual rows)
# REFERENCE_PRUNE_SEED=false

# ── Outreach / LLM ────────────────────────────────────────────
# Drafts are LLM-written only when a key exists (OPENAI_API_KEY above, or Settings → Integrations); otherwise a deterministic template is used.
# Max LLM-generated drafts per workspace per UTC day (0 = never call the LLM).
LLM_DAILY_DRAFT_LIMIT=300

# ── CRM webhook (optional, e.g. Twenty / n8n / Zapier) ─────────
# "Export" on a lead POSTs it with its DRAFT (never sends messages). Signed with HMAC-SHA256 in X-Prospector-Signature when a secret is set.
# LEAD_WEBHOOK_URL=
# LEAD_WEBHOOK_SECRET=

# ── Logging / tuning ──────────────────────────────────────────
# json | text (default: json in production, text otherwise)
# LOG_FORMAT=text
# Poll interval for the gosom sidecar job status (ms)
# GOSOM_POLL_MS=4000
