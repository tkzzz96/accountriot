{
  "name": "prospex",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI-powered GTM automation platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:migrate": "turbo db:migrate",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report",
    "test": "turbo test",
    "app": "bash scripts/start-local.sh",
    "app:stop": "bash scripts/start-local.sh stop"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.14.4",
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "multer": "^2.5.0",
      "lodash": "^4.18.0",
      "js-yaml@4": "^4.3.2",
      "postcss": "^8.5.23",
      "qs": "^6.16.1",
      "body-parser@1": "^1.20.9",
      "body-parser@2": "^2.4.0",
      "nanoid@3": "^3.3.18",
      "browserslist": "^4.28.7",
      "fast-uri": "^3.1.9",
      "source-map-js": "^1.2.2",
      "baseline-browser-mapping": "^2.11.0",
      "postcss-selector-parser@6": "^6.1.5",
      "file-type": "^21.3.2",
      "tmp": "^0.2.6",
      "picomatch@4": "^4.0.4",
      "glob@10": "^10.5.0",
      "ajv@8": "^8.18.0",
      "ip-address": "^10.7.4",
      "sharp": "^0.35.5",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "deepmerge-ts": "^8.0.0"
    }
  }
}
